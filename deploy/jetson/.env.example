# Environment template for HA-MEEM AI Surveillance on Jetson.
# Copy this file to /opt/ha-meem/.env on the Jetson device.
# Do NOT commit the actual .env file containing real credentials to Git.

# API configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_FILE=/app/logs/events.jsonl

# External components coordinates (if rules engine/central server is integrated)
NATS_URL=nats://192.168.1.100:4222
REDIS_URL=redis://192.168.1.100:6379
MINIO_ENDPOINT=192.168.1.100:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me

# Model Engine Verification (optional validation checks)
TRT_ENGINE_SHA_SCRFD=
TRT_ENGINE_SHA_ADAFACE=
